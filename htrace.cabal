cabal-version:      2.4
name:               htrace
version:            0.1.0.0
synopsis:           OpenTelemetry-compliant distributed tracing for Haskell
description:
  htrace provides OpenTelemetry-compliant distributed tracing for Haskell
  applications. It implements the W3C traceparent propagation standard,
  OTLP/HTTP JSON export, async batching, and environment-based configuration
  following the OTEL_* specification.
license:            MIT
author:             htrace contributors
maintainer:         htrace@example.com
category:           Tracing, OpenTelemetry
extra-source-files: test/snapshots/*.json

common shared
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    OverloadedStrings
    ScopedTypeVariables
    TupleSections
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies
    -Wredundant-constraints

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Trace
    Trace.Attributes
    Trace.Config
    Trace.Core
    Trace.Export.Batch
    Trace.Export.Otlp
    Trace.Export.Types
    Trace.Monad
    Trace.Propagation
  other-modules:
    Paths_htrace
  autogen-modules:
    Paths_htrace
  build-depends:
    , base                 >= 4.18 && < 5
    , aeson                >= 2.2  && < 2.3
    , base16-bytestring    >= 1.0  && < 1.1
    , bytestring           >= 0.11 && < 0.13
    , case-insensitive     >= 1.2  && < 1.3
    , crypton              >= 0.34 && < 1.1
    , http-client          >= 0.7  && < 0.8
    , http-client-tls      >= 0.3  && < 0.4
    , http-types           >= 0.12 && < 0.13
    , network-uri          >= 2.6  && < 2.7
    , stm                  >= 2.5  && < 2.6
    , text                 >= 2.0  && < 2.2
    , time                 >= 1.12 && < 1.15
    , unliftio             >= 0.2  && < 0.3
    , containers           >= 0.6  && < 0.8
    , mtl

test-suite htrace-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  other-modules:
    Trace.AttributesSpec
    Trace.ConfigSpec
    Trace.CoreSpec
    Trace.Export.BatchSpec
    Trace.Export.OtlpSpec
    Trace.Export.TypesSpec
    Trace.Generators
    Trace.IntegrationSpec
    Trace.MonadSpec
    Trace.PropagationSpec
  build-depends:
    , htrace
    , base                  >= 4.18 && < 5
    , aeson                 >= 2.2  && < 2.3
    , aeson-diff            >= 0.1  && < 2.0
    , aeson-pretty          >= 0.8  && < 0.9
    , base16-bytestring     >= 1.0  && < 1.1
    , bytestring            >= 0.11 && < 0.13
    , case-insensitive      >= 1.2  && < 1.3
    , containers            >= 0.6  && < 0.8
    , hedgehog              >= 1.4  && < 1.6
    , hspec                 >= 2.11 && < 2.12
    , hspec-discover        >= 2.11 && < 2.12
    , hspec-hedgehog        >= 0.1  && < 1.0
    , http-types            >= 0.12 && < 0.13
    , QuickCheck            >= 2.14 && < 2.16
    , quickcheck-instances  >= 0.3  && < 0.4
    , stm                   >= 2.5  && < 2.6
    , text                  >= 2.0  && < 2.2
    , time                  >= 1.12 && < 1.15
    , unliftio              >= 0.2  && < 0.3
    , wai                   >= 3.2  && < 3.3
    , warp                  >= 3.4  && < 3.5
    , mtl

benchmark htrace-bench
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   bench
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  other-modules:
    BatchBench
  build-depends:
    , htrace
    , base           >= 4.18 && < 5
    , tasty-bench    >= 0.3  && < 1.0
    , text           >= 2.0  && < 2.2
    , mtl